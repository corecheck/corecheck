            "properties": [{"id": "displayName", "value": "Max (s)"}, {"id": "custom.width", "value": 110}]
          }
        ]
      },
      "gridPos": {"h": 10, "w": 8, "x": 8, "y": 59},
      "id": 304,
      "options": {"showHeader": true},
      "targets": [
        {
          "datasource": {"type": "cloudwatch", "uid": "corecheck-cloudwatch"},
          "expression": "filter test_type = \"unit\" and duration_s > 0 | stats stddev(duration_s) as stddev_s, min(duration_s) as min_s, max(duration_s) as max_s by test_name | sort stddev_s desc | limit 15",
          "hide": false,
