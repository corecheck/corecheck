      "targets": [
        {
          "datasource": {"type": "cloudwatch", "uid": "corecheck-cloudwatch"},
          "expression": "fields test_name, duration_s, if(toMillis(@timestamp) < ($${__from} + $${__to}) / 2, duration_s, null) as early_d, if(toMillis(@timestamp) >= ($${__from} + $${__to}) / 2, duration_s, null) as late_d | filter test_type = \"unit\" and duration_s > 0 | stats pct(early_d, 50) as baseline_s, pct(late_d, 50) as current_s, count(early_d) as n_early, count(late_d) as n_late by test_name | filter n_early >= 3 and n_late >= 3 and baseline_s >= 10 | fields (current_s - baseline_s) / baseline_s as pct_change | filter pct_change < 0 | sort pct_change asc | limit 20",
