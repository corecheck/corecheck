{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {"type": "grafana", "uid": "-- Grafana --"},
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "target": {"limit": 100, "matchAny": false, "tags": [], "type": "dashboard"}
      }
    ]
  },
  "description": "Bitcoin Core test suite performance over time. Functional and unit test durations are stored in CloudWatch Logs (${test_results_log_group}) on each master commit.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [

    {
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 0},
      "id": 100,
      "title": "Overview",
      "type": "row"
    },

    {
      "datasource": {"type": "cloudwatch", "uid": "corecheck-cloudwatch"},
      "description": "Number of distinct functional tests seen in the selected time range.",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "thresholds": {"mode": "absolute", "steps": [{"color": "blue", "value": null}]},
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {"h": 4, "w": 6, "x": 0, "y": 1},
      "id": 1,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "/^cnt$/", "values": false},
        "textMode": "value"
      },
      "targets": [
        {
          "datasource": {"type": "cloudwatch", "uid": "corecheck-cloudwatch"},
          "expression": "filter test_type = \"functional\" | stats count_distinct(test_name) as cnt",
          "hide": false,
          "id": "A",
          "logGroups": [{"name": "${test_results_log_group}"}],
          "queryMode": "Logs",
          "refId": "A",
          "region": "${compute_region}"
        }
      ],
      "title": "Functional tests",
      "type": "stat"
    },

    {
      "datasource": {"type": "cloudwatch", "uid": "corecheck-cloudwatch"},
      "description": "Number of distinct unit tests (ctest suites) seen in the selected time range.",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "thresholds": {"mode": "absolute", "steps": [{"color": "blue", "value": null}]},
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {"h": 4, "w": 6, "x": 6, "y": 1},
      "id": 2,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "/^cnt$/", "values": false},
        "textMode": "value"
      },
      "targets": [
        {
          "datasource": {"type": "cloudwatch", "uid": "corecheck-cloudwatch"},
          "expression": "filter test_type = \"unit\" | stats count_distinct(test_name) as cnt",
          "hide": false,
          "id": "A",
          "logGroups": [{"name": "${test_results_log_group}"}],
          "queryMode": "Logs",
          "refId": "A",
          "region": "${compute_region}"
        }
      ],
      "title": "Unit tests",
      "type": "stat"
    },

    {
      "gridPos": {"h": 1, "w": 4, "x": 20, "y": 1},
      "id": 110,
      "options": {},
      "title": "",
      "transparent": true,
      "type": "corecheck-anchor"
    },

    {
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 5},
      "id": 200,
      "title": "Functional tests",
      "type": "row"
    },

    {
      "datasource": {"type": "cloudwatch", "uid": "corecheck-cloudwatch"},
      "description": "Average duration of functional tests over the selected time range, sorted slowest first. Click a test to jump to its duration graph.",
      "fieldConfig": {
        "defaults": {"unit": "s"},
        "overrides": [
          {
            "matcher": {"id": "byName", "options": "test_name"},
            "properties": [
              {"id": "displayName", "value": "Test"},
              {"id": "links", "value": [{"title": "Show trend", "url": "#functional-trend~$${__data.fields.test_name}"}]}
            ]
          },
          {
            "matcher": {"id": "byName", "options": "avg_duration_s"},
            "properties": [{"id": "displayName", "value": "Avg duration (s)"}, {"id": "custom.width", "value": 140}]
          },
          {
            "matcher": {"id": "byName", "options": "max_duration_s"},
            "properties": [{"id": "displayName", "value": "Max duration (s)"}, {"id": "custom.width", "value": 140}]
          }
        ]
      },
      "gridPos": {"h": 10, "w": 8, "x": 16, "y": 27},
      "id": 201,
      "options": {"showHeader": true, "sortBy": [{"desc": true, "displayName": "Avg duration (s)"}]},
      "targets": [
        {
          "datasource": {"type": "cloudwatch", "uid": "corecheck-cloudwatch"},
          "expression": "filter test_type = \"functional\" | stats avg(duration_s) as avg_duration_s, max(duration_s) as max_duration_s by test_name | sort avg_duration_s desc | limit 25",
          "hide": false,
          "id": "A",
          "logGroups": [{"name": "${test_results_log_group}"}],
          "queryMode": "Logs",
          "refId": "A",
          "region": "${compute_region}"
        }
      ],
      "title": "Slowest functional tests (top 25)",
      "transformations": [
        {"id": "organize", "options": {"excludeByName": {"Value": true, "n_early": true, "n_late": true}, "indexByName": {}, "renameByName": {}}}
      ],
      "type": "table"
    },

    {
      "datasource": {"type": "cloudwatch", "uid": "corecheck-cloudwatch"},
      "description": "Percent change from the median duration in the earlier half of the selected range (duration previously) to the median in the later half (duration now). A test is listed only when both halves have at least 3 runs and the earlier median is at least 10s. Click a test to jump to its duration graph.",
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {"id": "byName", "options": "test_name"},
            "properties": [
              {"id": "displayName", "value": "Test"},
              {"id": "links", "value": [{"title": "Show trend", "url": "#functional-trend~$${__data.fields.test_name}"}]}
            ]
          },
          {
            "matcher": {"id": "byName", "options": "baseline_s"},
            "properties": [{"id": "displayName", "value": "Duration previously"}, {"id": "unit", "value": "s"}, {"id": "custom.width", "value": 170}]
          },
          {
            "matcher": {"id": "byName", "options": "current_s"},
            "properties": [{"id": "displayName", "value": "Duration now"}, {"id": "unit", "value": "s"}, {"id": "custom.width", "value": 140}]
          },
          {
            "matcher": {"id": "byName", "options": "pct_change"},
            "properties": [
              {"id": "displayName", "value": "Change"},
              {"id": "unit", "value": "percentunit"},
              {"id": "custom.width", "value": 110},
              {"id": "custom.displayMode", "value": "color-background"},
              {"id": "thresholds", "value": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 0.1}]}}
            ]
          }
        ]
      },
      "gridPos": {"h": 12, "w": 24, "x": 0, "y": 6},
      "id": 202,
      "options": {"showHeader": true, "sortBy": [{"desc": true, "displayName": "Change"}]},
      "targets": [
        {
          "datasource": {"type": "cloudwatch", "uid": "corecheck-cloudwatch"},
          "expression": "fields test_name, duration_s, if(toMillis(@timestamp) < ($${__from} + $${__to}) / 2, duration_s, null) as early_d, if(toMillis(@timestamp) >= ($${__from} + $${__to}) / 2, duration_s, null) as late_d | filter test_type = \"functional\" and duration_s > 0 | stats pct(early_d, 50) as baseline_s, pct(late_d, 50) as current_s, count(early_d) as n_early, count(late_d) as n_late by test_name | filter n_early >= 3 and n_late >= 3 and baseline_s >= 10 | fields (current_s - baseline_s) / baseline_s as pct_change | filter pct_change > 0 | sort pct_change desc | limit 20",
          "hide": false,
          "id": "A",
          "logGroups": [{"name": "${test_results_log_group}"}],
          "queryMode": "Logs",
          "refId": "A",
          "region": "${compute_region}"
        }
      ],
      "title": "Biggest slowdowns (functional)",
      "transformations": [
        {"id": "organize", "options": {"excludeByName": {"Value": true, "n_early": true, "n_late": true}, "indexByName": {}, "renameByName": {}}}
      ],
      "type": "table"
    },

    {
      "datasource": {"type": "cloudwatch", "uid": "corecheck-cloudwatch"},
      "description": "Percent change from the median duration in the earlier half of the selected range (duration previously) to the median in the later half (duration now). A test is listed only when both halves have at least 3 runs and the earlier median is at least 10s. Click a test to jump to its duration graph.",
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {"id": "byName", "options": "test_name"},
            "properties": [
              {"id": "displayName", "value": "Test"},
              {"id": "links", "value": [{"title": "Show trend", "url": "#functional-trend~$${__data.fields.test_name}"}]}
            ]
          },
          {
            "matcher": {"id": "byName", "options": "baseline_s"},
            "properties": [{"id": "displayName", "value": "Duration previously"}, {"id": "unit", "value": "s"}, {"id": "custom.width", "value": 170}]
          },
          {
            "matcher": {"id": "byName", "options": "current_s"},
            "properties": [{"id": "displayName", "value": "Duration now"}, {"id": "unit", "value": "s"}, {"id": "custom.width", "value": 140}]
          },
          {
            "matcher": {"id": "byName", "options": "pct_change"},
            "properties": [
              {"id": "displayName", "value": "Change"},
              {"id": "unit", "value": "percentunit"},
              {"id": "custom.width", "value": 110},
              {"id": "custom.displayMode", "value": "color-background"},
              {"id": "thresholds", "value": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": -0.1}]}}
            ]
          }
        ]
      },
      "gridPos": {"h": 10, "w": 8, "x": 0, "y": 27},
      "id": 203,
      "options": {"showHeader": true, "sortBy": [{"desc": false, "displayName": "Change"}]},
      "targets": [
        {
          "datasource": {"type": "cloudwatch", "uid": "corecheck-cloudwatch"},
          "expression": "fields test_name, duration_s, if(toMillis(@timestamp) < ($${__from} + $${__to}) / 2, duration_s, null) as early_d, if(toMillis(@timestamp) >= ($${__from} + $${__to}) / 2, duration_s, null) as late_d | filter test_type = \"functional\" and duration_s > 0 | stats pct(early_d, 50) as baseline_s, pct(late_d, 50) as current_s, count(early_d) as n_early, count(late_d) as n_late by test_name | filter n_early >= 3 and n_late >= 3 and baseline_s >= 10 | fields (current_s - baseline_s) / baseline_s as pct_change | filter pct_change < 0 | sort pct_change asc | limit 20",
          "hide": false,
          "id": "A",
          "logGroups": [{"name": "${test_results_log_group}"}],
          "queryMode": "Logs",
          "refId": "A",
          "region": "${compute_region}"
        }
      ],
      "title": "Biggest speedups (functional)",
      "transformations": [
        {"id": "organize", "options": {"excludeByName": {"Value": true, "n_early": true, "n_late": true}, "indexByName": {}, "renameByName": {}}}
      ],
      "type": "table"
    },

    {
      "datasource": {"type": "cloudwatch", "uid": "corecheck-cloudwatch"},
      "description": "Functional tests with the widest spread of durations in the selected time range. Click a test to jump to its duration graph.",
      "fieldConfig": {
        "defaults": {"unit": "s"},
        "overrides": [
          {
            "matcher": {"id": "byName", "options": "test_name"},
            "properties": [
              {"id": "displayName", "value": "Test"},
              {"id": "links", "value": [{"title": "Show trend", "url": "#functional-trend~$${__data.fields.test_name}"}]}
            ]
          },
          {
            "matcher": {"id": "byName", "options": "stddev_s"},
            "properties": [{"id": "displayName", "value": "Stddev (s)"}, {"id": "custom.width", "value": 120}]
          },
          {
            "matcher": {"id": "byName", "options": "min_s"},
            "properties": [{"id": "displayName", "value": "Min (s)"}, {"id": "custom.width", "value": 110}]
          },
          {
            "matcher": {"id": "byName", "options": "max_s"},
            "properties": [{"id": "displayName", "value": "Max (s)"}, {"id": "custom.width", "value": 110}]
          }
        ]
      },
      "gridPos": {"h": 10, "w": 8, "x": 8, "y": 27},
      "id": 204,
      "options": {"showHeader": true},
      "targets": [
        {
          "datasource": {"type": "cloudwatch", "uid": "corecheck-cloudwatch"},
          "expression": "filter test_type = \"functional\" and duration_s > 0 | stats stddev(duration_s) as stddev_s, min(duration_s) as min_s, max(duration_s) as max_s by test_name | sort stddev_s desc | limit 15",
          "hide": false,
          "id": "A",
          "logGroups": [{"name": "${test_results_log_group}"}],
          "queryMode": "Logs",
          "refId": "A",
          "region": "${compute_region}"
        }
      ],
      "title": "Most variable functional tests",
      "transformations": [
        {"id": "organize", "options": {"excludeByName": {"Value": true, "n_early": true, "n_late": true}, "indexByName": {}, "renameByName": {}}}
      ],
      "type": "table"
    },

    {
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 37},
      "id": 300,
      "title": "Unit tests",
      "type": "row"
    },

    {
      "datasource": {"type": "cloudwatch", "uid": "corecheck-cloudwatch"},
