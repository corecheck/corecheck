    {
      "datasource": {"type": "cloudwatch", "uid": "corecheck-cloudwatch"},
      "description": "Percent change from the median duration in the earlier half of the selected range (duration previously) to the median in the later half (duration now). A suite is listed only when both halves have at least 3 runs and the earlier median is at least 10s. Click a suite to jump to its duration graph.",
      "fieldConfig": {
