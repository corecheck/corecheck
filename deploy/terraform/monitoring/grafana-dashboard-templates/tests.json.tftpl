    {
      "datasource": {"type": "cloudwatch", "uid": "corecheck-cloudwatch"},
      "description": "Unit test suites with the widest spread of durations in the selected time range. Click a suite to jump to its duration graph.",
      "fieldConfig": {
        "defaults": {"unit": "s"},
        "overrides": [
          {
            "matcher": {"id": "byName", "options": "test_name"},
            "properties": [
              {"id": "displayName", "value": "Test suite"},
              {"id": "links", "value": [{"title": "Show trend", "url": "#unit-trend~$${__data.fields.test_name}"}]}
            ]
