+BOOST_AUTO_TEST_CASE(sha3_256_partial_buffer_rate_boundary)
+{
+    // 129 bytes fills the 8-byte buffer on a rate boundary (RATE_BUFFERS == 17),
+    // then 7 more bytes take the fill path that permutes before the direct loop.
+    std::vector<unsigned char> data(136);
+    for (size_t i = 0; i < data.size(); ++i) data[i] = static_cast<unsigned char>(i);
+
+    SHA3_256 split;
+    split.Write(std::span{data}.first(129));
+    split.Write(std::span{data}.subspan(129));
+    unsigned char out_split[SHA3_256::OUTPUT_SIZE];
+    split.Finalize(out_split);
+
+    SHA3_256 once;
+    once.Write(data);
+    unsigned char out_once[SHA3_256::OUTPUT_SIZE];
+    once.Finalize(out_once);
+    BOOST_CHECK(std::equal(std::begin(out_split), std::end(out_split), std::begin(out_once)));
+}
