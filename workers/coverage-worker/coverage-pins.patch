     }
 }
 
+BOOST_AUTO_TEST_CASE(BlockPolicyDoubleEstimateReason)
+{
+    CBlockPolicyEstimator feeEst{BlockPolicyFeeEstPath(*m_node.args), DEFAULT_ACCEPT_STALE_FEE_ESTIMATES};
+    TestMemPoolEntryHelper entry;
+    CScript garbage;
+    for (unsigned int i = 0; i < 128; i++) garbage.push_back('X');
+    CMutableTransaction tx;
+    tx.vin.resize(1);
+    tx.vin[0].scriptSig = garbage;
+    tx.vout.resize(1);
+    tx.vout[0].nValue = 0;
+
+    const CAmount low_fee{2000};
+    const CAmount high_fee{20000};
+
+    struct HeldLow {
+        CTxMemPoolEntry entry;
+        int tx_height;
+        bool drop;
+        HeldLow(CTxMemPoolEntry e, int height, bool drop_in) : entry(std::move(e)), tx_height(height), drop(drop_in) {}
+    };
+    std::list<HeldLow> pending;
+
+    // processTransaction only tracks a transaction whose height equals the last
+    // block the estimator has seen. Confirmations are counted from that height.
+    unsigned int seen{0};
+    for (int i = 0; i < 80; ++i) {
+        std::vector<RemovedMempoolTransactionInfo> block;
+
+        tx.vin[0].prevout.n = 100000 + i;
+        const auto high_ref{MakeTransactionRef(tx)};
+        auto high_entry{entry.Fee(high_fee).Time(Now<NodeSeconds>()).Height(seen).FromTx(tx)};
+        feeEst.processTransaction(NewMempoolTransactionInfo(high_ref, high_fee, GetVirtualTransactionSize(*high_ref), high_entry.GetHeight(),
+                                                             /*mempool_limit_bypassed=*/false, /*submitted_in_package=*/false,
+                                                             /*chainstate_is_current=*/true, /*has_no_mempool_parents=*/true));
+        block.emplace_back(high_entry);
+
+        for (auto it = pending.begin(); it != pending.end();) {
+            const int age{static_cast<int>(seen) - it->tx_height};
+            // Included in the block at seen+1, so age 1 confirms in 2 blocks.
+            if (!it->drop && age == 1) {
+                block.emplace_back(it->entry);
+                it = pending.erase(it);
+            } else if (it->drop && age >= 8) {
+                feeEst.removeTx(it->entry.GetTx().GetHash());
+                it = pending.erase(it);
+            } else {
+                ++it;
+            }
+        }
+
+        for (int k = 0; k < 10; ++k) {
+            tx.vin[0].prevout.n = 10000 * i + k;
+            const auto low_ref{MakeTransactionRef(tx)};
+            auto low_entry{entry.Fee(low_fee).Time(Now<NodeSeconds>()).Height(seen).FromTx(tx)};
+            feeEst.processTransaction(NewMempoolTransactionInfo(low_ref, low_fee, GetVirtualTransactionSize(*low_ref), low_entry.GetHeight(),
+                                                                 /*mempool_limit_bypassed=*/false, /*submitted_in_package=*/false,
+                                                                 /*chainstate_is_current=*/true, /*has_no_mempool_parents=*/true));
+            pending.emplace_back(std::move(low_entry), static_cast<int>(seen), /*drop_in=*/k == 9);
+        }
+
+        feeEst.processBlock(block, seen + 1);
+        ++seen;
+    }
+
+    FeeCalculation calc;
+    const CFeeRate rate{feeEst.estimateSmartFee(/*confTarget=*/4, &calc, /*conservative=*/false)};
+    BOOST_CHECK(rate > CFeeRate{0});
+    BOOST_CHECK_MESSAGE(calc.reason == BlockPolicyEstimateReason::DOUBLE_ESTIMATE, StringForBlockPolicyEstimateReason(calc.reason));
+    BOOST_CHECK_EQUAL(StringForBlockPolicyEstimateReason(BlockPolicyEstimateReason::DOUBLE_ESTIMATE), "Double Target 95% Threshold");
+}
+
 BOOST_AUTO_TEST_SUITE_END()
