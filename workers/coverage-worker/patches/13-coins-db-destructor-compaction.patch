+BOOST_FIXTURE_TEST_CASE(coins_db_destructor_waits_for_compaction, FlushTest)
+{
+    // A CCoinsViewDB destroyed while a background compaction is still running must wait for
+    // it and log that it is waiting. At shutdown the compaction is started from
+    // validation.cpp and the view is destroyed as the node stops, so whether the future is
+    // ready at that instant is a matter of timing; here the view is destroyed right after
+    // the compaction is launched.
+    const COutPoint outpoint{Txid::FromUint256(m_rng.rand256()), 0};
+    Coin coin{MakeCoin()};
+    auto base{std::make_unique<CCoinsViewDB>(
+        DBParams{.path = m_args.GetDataDirBase() / "coins_db_compaction",
+                 .cache_bytes = 1_MiB,
+                 .wipe_data = true},
+        CoinsViewOptions{})};
+    {
+        CCoinsViewCache cache{base.get()};
+        cache.EmplaceCoinInternalDANGER(outpoint, std::move(coin));
+        cache.SetBestBlock(m_rng.rand256());
+        cache.Sync();
+    }
+    WITH_LOCK(::cs_main, (void)base->CompactFullAsync());
+    base.reset(); // destructor must wait for the compaction and log that it does
+}
