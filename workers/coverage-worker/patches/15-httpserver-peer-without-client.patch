+BOOST_AUTO_TEST_CASE(http_request_get_peer_without_client)
+{
+    // A request whose client has already gone away (the weak_ptr expired) must
+    // report an empty peer rather than dereferencing anything. The live-client
+    // case is covered by http_server_socket_tests, but that one only reaches the
+    // expired-client branch when the client happens to be destroyed first, which
+    // is a race; this exercises it deterministically.
+    HTTPRequest req;
+    BOOST_CHECK(req.GetPeer() == CService{});
+    BOOST_CHECK(!req.GetClient());
+}
