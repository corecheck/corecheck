+BOOST_AUTO_TEST_CASE(open_network_connection_refused_after_interrupt)
+{
+    // OpenNetworkConnection() refuses to start a new connection once the connection manager has
+    // been interrupted (net.cpp:3148-3149). A functional run only reaches it when a connection
+    // attempt is still in flight while the node shuts down (p2p_private_broadcast.py,
+    // feature_proxy.py), which is a scheduling race; here the interrupt is raised first.
+    ConnmanTestMsg connman{0x1337, 0x1337, *m_node.addrman, *m_node.netgroupman, Params()};
+    connman.Interrupt();
+
+    BOOST_CHECK(!connman.OpenNetworkConnection(/*addrConnect=*/CAddress{},
+                                               /*fCountFailure=*/false,
+                                               /*grant_outbound=*/{},
+                                               /*pszDest=*/"127.0.0.1:1",
+                                               /*conn_type=*/ConnectionType::MANUAL,
+                                               /*use_v2transport=*/false,
+                                               /*proxy_override=*/std::nullopt));
+}
