+    BOOST_CHECK_EQUAL(StringForBlockPolicyEstimateReason(R::DOUBLE_ESTIMATE), "Double Target 95% Threshold");
+    BOOST_CHECK_EQUAL(StringForBlockPolicyEstimateReason(R::CONSERVATIVE), "Conservative Double Target longer horizon");
+}
